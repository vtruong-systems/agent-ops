# Shared defaults for Mac -> Ubuntu k3s development.
# Override any value in the environment before running the scripts.
#
# Same Ubuntu node, k3s API, SSH identity, Docker daemon, and localhost:5000
# registry as RAGline. Isolation is namespace, Helm release, remote checkout,
# image name prefix, and Service ports — not a second cluster.
# Do not run bootstrap on this host; Docker/k3s/registry already exist.
# RAGline already binds node port 8000. Pick a different port for agent-ops UIs.

AGENT_OPS_SSH_HOST="${AGENT_OPS_SSH_HOST:-192.168.68.62}"
AGENT_OPS_SSH_USER="${AGENT_OPS_SSH_USER:-van}"
AGENT_OPS_SSH_IDENTITY="${AGENT_OPS_SSH_IDENTITY:-${HOME}/.ssh/mac-ubuntu}"
AGENT_OPS_K8S_API="${AGENT_OPS_K8S_API:-https://${AGENT_OPS_SSH_HOST}:6443}"
AGENT_OPS_NAMESPACE="${AGENT_OPS_NAMESPACE:-agent-ops}"
AGENT_OPS_RELEASE="${AGENT_OPS_RELEASE:-agent-ops}"
AGENT_OPS_REMOTE_ROOT="${AGENT_OPS_REMOTE_ROOT:-/home/van/src/agent-ops}"
AGENT_OPS_REGISTRY="${AGENT_OPS_REGISTRY:-localhost:5000}"
AGENT_OPS_REGISTRY_PORT="${AGENT_OPS_REGISTRY_PORT:-5000}"
AGENT_OPS_CHART_DIR="${AGENT_OPS_CHART_DIR:-charts/agent-ops}"
AGENT_OPS_VALUES_FILE="${AGENT_OPS_VALUES_FILE:-charts/agent-ops/values-local.yaml}"
AGENT_OPS_SECRETS_VALUES="${AGENT_OPS_SECRETS_VALUES:-charts/agent-ops/values-local-secrets.yaml}"
AGENT_OPS_SERVICES="${AGENT_OPS_SERVICES:-}"
AGENT_OPS_SERVICE_ALLOWLIST="${AGENT_OPS_SERVICE_ALLOWLIST:-runtime}"
AGENT_OPS_PROBE_IMAGE="${AGENT_OPS_PROBE_IMAGE:-rancher/local-path-provisioner:v0.0.35}"
AGENT_OPS_GITHUB_IDENTITY="${AGENT_OPS_GITHUB_IDENTITY:-${HOME}/.ssh/vtruong-github-daeda.pem}"
AGENT_OPS_CONFIG_DIR="${AGENT_OPS_CONFIG_DIR:-${HOME}/.config/agent-ops}"
AGENT_OPS_IMAGE_PREFIX="${AGENT_OPS_IMAGE_PREFIX:-agent-ops}"
# RAGline chat-ui already uses node port 8000. Leave empty until agent-ops
# exposes its own Service, then set e.g. 8001.
AGENT_OPS_SMOKE_PORT="${AGENT_OPS_SMOKE_PORT:-}"
AGENT_OPS_LOCAL_PORT="${AGENT_OPS_LOCAL_PORT:-18080}"
